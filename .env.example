# Public origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.josiahdalisay.com"

# Contact form. Create a key at https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sender for the Resend domain. Falls back to Resend's shared
# onboarding address, which only delivers to your own account email.
CONTACT_FROM_EMAIL="Website <hello@josiahdalisay.com>"

# Where enquiries land. Defaults to site.email in src/content/site.ts
CONTACT_TO_EMAIL="hello@josiahdalisay.com"

# Origin of the Virtual Office app (its own Vercel project). Setting this
# turns on the /office rewrite; leave it unset and /office 404s.
OFFICE_ORIGIN=""
